# Google Apps Script Web App URL that receives all form submissions
# (registration, partner, volunteer, route-vote). See
# scripts/google-apps-script.gs for the script + deployment steps.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_URL_DEPLOYMENT_ID=

# Which payment gateway processes registration payments — "flutterwave"
# or "paystack" (src/features/base/lib/server/payment/). Each gateway
# self-checks its own required vars below and throws a clear error if
# they're missing, so only the active one actually needs to be filled in.
PAYMENT_GATEWAY=flutterwave

# Flutterwave v3 Standard payment flow. The secret key is server-only,
# never exposed to the browser. FLUTTERWAVE_SECRET_HASH must match the
# "Secret Hash" configured on the webhook in the Flutterwave dashboard
# (Settings -> Webhooks) — it's a value you choose, not something
# Flutterwave issues you.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_HASH=choose-a-random-string-and-set-it-in-the-flutterwave-dashboard-too

# Paystack Standard payment flow (used when PAYMENT_GATEWAY=paystack).
# No separate webhook secret — Paystack signs webhooks with an HMAC of
# this same secret key.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend — sends the registration confirmation email once payment is
# verified (src/features/base/lib/server/email-client.ts). EMAIL_FROM's
# domain must be verified in the Resend dashboard or sending will fail.
# EMAIL_REPLY_TO doesn't need to be on the same (or any verified) domain
# — it's just where the "Reply-To" header points and what the email body
# tells riders to write to, independent of the sending domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="EKO170 <registrations@yourdomain.com>"
EMAIL_REPLY_TO=info@eko170.com

# Absolute site origin — used to build the redirect_url sent to
# Flutterwave (it redirects the rider back to {SITE_URL}/register/verify
# after checkout). Use http://localhost:3000 for local dev.
SITE_URL=https://eko170.com

# Registration state
REGISTRATION_STATE=starting_soon # pre-register | register
